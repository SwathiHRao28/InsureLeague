# --- Supabase ---
# From Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SECRET — server-side only. Never expose this or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender on your Resend account/domain.
EMAIL_FROM_ADDRESS="InsureLeague <onboarding@resend.dev>"
# Where callback-request notifications are sent.
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com
